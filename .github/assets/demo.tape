Output ./.github/assets/demo.gif
Require revshell

Set Shell "zsh"
Set FontSize 24
Set Width 2100
Set Height 1800

Type "revshell"
Sleep 800ms
Enter
Sleep 2s

Type "/"
Sleep 500ms
Type "bash"
Sleep 1500ms
Escape
Sleep 500ms

Down@400ms 4
Sleep 1500ms

Ctrl+O
Sleep 800ms

Enter
Sleep 300ms
Ctrl+U
Type "10.10.14.5"
Sleep 800ms
Enter
Sleep 300ms

Down
Sleep 300ms
Enter
Ctrl+U
Type "4444"
Sleep 800ms
Enter
Sleep 300ms

Down
Sleep 300ms
Enter
Ctrl+U
Type "/bin/bash"
Sleep 1s
Enter
Sleep 300ms

Escape
Sleep 500ms

Type "y"
Sleep 2s

Type "o"
Sleep 1s
Type "o"
Sleep 1500ms

Type "c"
Sleep 1500ms

Type "e"
Sleep 1500ms
Type "e"
Sleep 2500ms
